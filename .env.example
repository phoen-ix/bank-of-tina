# Flask Configuration
# Generate a strong random key, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# MariaDB -- pick your own passwords before the first start.
DB_ROOT_PASSWORD=rootchangeme
DB_NAME=bank_of_tina
DB_USER=tina
DB_PASSWORD=tina

# Network interface the web port (5000) is published on. The app has no login,
# so the default only allows access from the Docker host itself (put an
# authenticating reverse proxy in front). Set to 0.0.0.0 to allow access from
# your LAN -- only on a network where everyone may see and change all data.
# BIND_ADDRESS=127.0.0.1

# SMTP credentials are configured inside the web UI under Settings → Email.
# No SMTP variables are needed here.
